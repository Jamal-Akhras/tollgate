<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.jamal-akhras</groupId>
    <artifactId>tollgate-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>tollgate-server</artifactId>
  <name>Tollgate Server</name>
  <description>Standalone gateway: the OpenAI and Anthropic APIs on the gateway port, the admin API on its own port.</description>

  <properties>
    <maven.compiler.release>25</maven.compiler.release>
    <image.name>ghcr.io/jamal-akhras/tollgate</image.name>
    <base.image>gcr.io/distroless/java25-debian13:nonroot@sha256:8ac5525549d14b8ddd34562f9fc8e6ba4840c995363a1507b17cadf8bb7ab57e</base.image>
    <coverage.line.minimum>0.85</coverage.line.minimum>
    <coverage.branch.minimum>0.80</coverage.branch.minimum>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.github.jamal-akhras</groupId>
      <artifactId>tollgate-core</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.jamal-akhras</groupId>
      <artifactId>tollgate-providers</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
    <dependency>
      <groupId>tools.jackson.dataformat</groupId>
      <artifactId>jackson-dataformat-yaml</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-api</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.github.jamal-akhras</groupId>
      <artifactId>tollgate-providers</artifactId>
      <version>${project.version}</version>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>build-info</goal>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>com.google.cloud.tools</groupId>
        <artifactId>jib-maven-plugin</artifactId>
        <configuration>
          <from>
            <image>${base.image}</image>
            <platforms>
              <platform>
                <architecture>amd64</architecture>
                <os>linux</os>
              </platform>
              <platform>
                <architecture>arm64</architecture>
                <os>linux</os>
              </platform>
            </platforms>
          </from>
          <to>
            <image>${image.name}:${project.version}</image>
          </to>
          <container>
            <mainClass>io.github.jamalakhras.tollgate.server.TollgateServerApplication</mainClass>
            <jvmFlags>
              <jvmFlag>-XX:+ExitOnOutOfMemoryError</jvmFlag>
            </jvmFlags>
            <environment>
              <TOLLGATE_CONFIG>/etc/tollgate/tollgate.yaml</TOLLGATE_CONFIG>
              <TOLLGATE_ADDRESS>0.0.0.0</TOLLGATE_ADDRESS>
              <TOLLGATE_ADMIN_ADDRESS>0.0.0.0</TOLLGATE_ADMIN_ADDRESS>
            </environment>
            <ports>
              <port>8080</port>
              <port>8081</port>
              <port>9090</port>
            </ports>
            <workingDirectory>/home/nonroot</workingDirectory>
            <labels>
              <org.opencontainers.image.title>Tollgate</org.opencontainers.image.title>
              <org.opencontainers.image.description>${project.description}</org.opencontainers.image.description>
              <org.opencontainers.image.source>https://github.com/Jamal-Akhras/tollgate</org.opencontainers.image.source>
              <org.opencontainers.image.licenses>Apache-2.0</org.opencontainers.image.licenses>
              <org.opencontainers.image.version>${project.version}</org.opencontainers.image.version>
            </labels>
          </container>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
