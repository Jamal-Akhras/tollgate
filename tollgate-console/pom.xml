<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.jamal-akhras</groupId>
    <artifactId>tollgate-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>tollgate-console</artifactId>
  <name>Tollgate Console</name>
  <description>The static web console served on the admin port.</description>

  <properties>
    <skipTests>false</skipTests>
    <frontend-maven-plugin.version>2.0.2</frontend-maven-plugin.version>
    <node.version>v24.22.3</node.version>
    <node.download.dir>${project.build.directory}/node-download</node.download.dir>
  </properties>

  <profiles>
    <profile>
      <id>node-windows-x64</id>
      <activation>
        <os>
          <family>windows</family>
          <arch>amd64</arch>
        </os>
      </activation>
      <properties>
        <node.archive>win-x64.zip</node.archive>
        <node.sha256>e612af99f626ab415ea225af6bce5c971feb448cb5cae250bb1c3fa50c5f7d9f</node.sha256>
      </properties>
    </profile>

    <profile>
      <id>node-linux-x64</id>
      <activation>
        <os>
          <family>unix</family>
          <name>linux</name>
          <arch>amd64</arch>
        </os>
      </activation>
      <properties>
        <node.archive>linux-x64.tar.gz</node.archive>
        <node.sha256>061ec3e3062115705b56b51fa9cc330ab50d34b6969387d4e4b1a50c6809acc2</node.sha256>
      </properties>
    </profile>

    <profile>
      <id>node-macos-x64</id>
      <activation>
        <os>
          <family>mac</family>
          <arch>x86_64</arch>
        </os>
      </activation>
      <properties>
        <node.archive>darwin-x64.tar.gz</node.archive>
        <node.sha256>977614af0504c81045e7fd85596dbca0e5f951b96681516dadafedcca8c447f7</node.sha256>
      </properties>
    </profile>

    <profile>
      <id>node-windows-arm64</id>
      <activation>
        <os>
          <family>windows</family>
          <arch>aarch64</arch>
        </os>
      </activation>
      <properties>
        <node.archive>win-arm64.zip</node.archive>
        <node.sha256>b3cc74a295b39d4f273271e96f58c06dd2b35757ca12abec64c7d0598b434f14</node.sha256>
      </properties>
    </profile>

    <profile>
      <id>node-linux-arm64</id>
      <activation>
        <os>
          <family>unix</family>
          <name>linux</name>
          <arch>aarch64</arch>
        </os>
      </activation>
      <properties>
        <node.archive>linux-arm64.tar.gz</node.archive>
        <node.sha256>261af2af250dfd7e9f25cf151d1b2713a0adf8f10a9ad116c4947f68627affe8</node.sha256>
      </properties>
    </profile>

    <profile>
      <id>node-macos-arm64</id>
      <activation>
        <os>
          <family>mac</family>
          <arch>aarch64</arch>
        </os>
      </activation>
      <properties>
        <node.archive>darwin-arm64.tar.gz</node.archive>
        <node.sha256>ff6e17d4874b76d272212b908cc020d6e815fba5a6c7eaaa06add725840307fd</node.sha256>
      </properties>
    </profile>
  </profiles>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>require-node-platform</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireProperty>
                  <property>node.sha256</property>
                  <message>No pinned Node.js checksum for this platform. Supported: windows x64 and arm64, linux x64 and arm64, macOS x64 and arm64.</message>
                </requireProperty>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>com.googlecode.maven-download-plugin</groupId>
        <artifactId>download-maven-plugin</artifactId>
        <version>1.13.0</version>
        <executions>
          <execution>
            <id>download-node</id>
            <goals>
              <goal>wget</goal>
            </goals>
            <phase>generate-resources</phase>
            <configuration>
              <url>https://nodejs.org/dist/${node.version}/node-${node.version}-${node.archive}</url>
              <outputDirectory>${node.download.dir}/${node.version}</outputDirectory>
              <outputFileName>node-${node.version}-${node.archive}</outputFileName>
              <sha256>${node.sha256}</sha256>
              <overwrite>true</overwrite>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>com.github.eirslett</groupId>
        <artifactId>frontend-maven-plugin</artifactId>
        <version>${frontend-maven-plugin.version}</version>
        <configuration>
          <nodeVersion>${node.version}</nodeVersion>
          <nodeDownloadRoot>${project.baseUri}target/node-download/</nodeDownloadRoot>
          <installDirectory>target</installDirectory>
        </configuration>
        <executions>
          <execution>
            <id>install-node-and-npm</id>
            <goals>
              <goal>install-node-and-npm</goal>
            </goals>
            <phase>generate-resources</phase>
          </execution>
          <execution>
            <id>npm-ci</id>
            <goals>
              <goal>npm</goal>
            </goals>
            <phase>generate-resources</phase>
            <configuration>
              <arguments>ci --ignore-scripts</arguments>
            </configuration>
          </execution>
          <execution>
            <id>npm-run-build</id>
            <goals>
              <goal>npm</goal>
            </goals>
            <phase>generate-resources</phase>
            <configuration>
              <arguments>run build</arguments>
            </configuration>
          </execution>
          <execution>
            <id>npm-run-check</id>
            <goals>
              <goal>npm</goal>
            </goals>
            <phase>test</phase>
            <configuration>
              <arguments>run check</arguments>
              <skip>${skipTests}</skip>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
