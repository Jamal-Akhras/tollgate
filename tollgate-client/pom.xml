<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.jamal-akhras</groupId>
    <artifactId>tollgate-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>tollgate-client</artifactId>
  <name>Tollgate Client</name>
  <description>Builds the official OpenAI and Anthropic Java clients for a Tollgate gateway.</description>

  <properties>
    <automatic.module.name>io.github.jamalakhras.tollgate.client</automatic.module.name>
    <maven.compiler.release>17</maven.compiler.release>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.openai</groupId>
      <artifactId>openai-java</artifactId>
      <version>${openai-java.version}</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>com.anthropic</groupId>
      <artifactId>anthropic-java</artifactId>
      <version>${anthropic-java.version}</version>
      <optional>true</optional>
    </dependency>

    <dependency>
      <groupId>io.github.jamal-akhras</groupId>
      <artifactId>tollgate-spring-boot-starter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.github.jamal-akhras</groupId>
      <artifactId>tollgate-providers</artifactId>
      <type>test-jar</type>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
